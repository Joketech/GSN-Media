# Copy to .env on the server; never commit .env.
APP_PORT=4188
# Run bash deploy/setup-v1.sh to create this key. Never commit the real key.
GSN_AGENT_TOKEN=
SITE_DOMAIN=studio.example.com
BASIC_AUTH_USER=owner
# Generate using: docker run --rm -it caddy:2-alpine caddy hash-password
# Put the hash in single quotes to preserve dollar signs in Docker Compose.
BASIC_AUTH_HASH='REPLACE_WITH_CADDY_PASSWORD_HASH'
# Internal workers in this Compose project; no public worker ports.
VOICE_WORKER_URL=http://voice:8091
VISUAL_WORKER_URL=http://visuals:8091
# Set to 1 to require the access key in the browser (the studio no longer shows a password page by default).
GSN_REQUIRE_KEY=
# Postiz (self-hosted) connection. Leave empty to stay in planning-only mode.
# POSTIZ_API_URL is the full public API base, e.g. https://postiz.example.com/api/public/v1
POSTIZ_API_URL=
# Postiz > Settings > Developers > Public API key. Never commit the real key.
POSTIZ_API_KEY=
# Optional cap on posts sent per hour (default is conservative).
POSTIZ_HOURLY_LIMIT=
# Background-removal worker (runs in Compose by default; models are baked into its image).
CUTOUT_WORKER_URL=http://cutout:8092

# Pictures from a written description (UGC editor "Generate background" and agents).
# Pick ONE way: an OpenAI-style service (set the key), or leave blank to use the GPU picture worker if you run it.
# IMAGE_GEN_PROVIDER=auto uses the key if present, else the worker. Set it to pollinations for the free hosted service
# (the prompt is sent to that website) or off to switch the feature off.
IMAGE_GEN_PROVIDER=auto
IMAGE_GEN_KEY=
IMAGE_GEN_URL=
IMAGE_GEN_MODEL=
IMAGE_GEN_HOURLY_LIMIT=40
