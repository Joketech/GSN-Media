FROM python:3.12-slim-bookworm
WORKDIR /worker
RUN pip install --no-cache-dir torch==2.6.0 torchvision==0.21.0 --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir diffusers==0.32.2 transformers==4.49.0 accelerate==1.4.0 safetensors==0.5.3 pillow==11.1.0
RUN useradd -r -u 10002 images && mkdir /data /models && chown images:images /data /models
COPY services/image_worker.py /worker/image_worker.py
ENV DATA_DIR=/data HF_HOME=/models PYTHONUNBUFFERED=1 PORT=8093 IMAGE_DEVICE=cpu OMP_NUM_THREADS=4
USER images
EXPOSE 8093
HEALTHCHECK --interval=30s --timeout=5s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8093/health',timeout=3)"
CMD ["python", "image_worker.py"]
