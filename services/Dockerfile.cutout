FROM python:3.12-slim-bookworm
WORKDIR /worker
RUN pip install --no-cache-dir "rembg[cpu]==2.0.67" pillow numpy
ENV U2NET_HOME=/models PYTHONUNBUFFERED=1 PORT=8092 OMP_NUM_THREADS=2
# Bake the models into the image so the worker never needs the internet at run time.
RUN python -c "from rembg import new_session; [new_session(m) for m in ('isnet-general-use','u2net_human_seg','u2net')]"
COPY services/cutout_worker.py /worker/cutout_worker.py
RUN useradd -r -u 10001 cutout && chown -R cutout /models
USER cutout
EXPOSE 8092
HEALTHCHECK --interval=30s --timeout=5s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8092/health',timeout=3)"
CMD ["python", "cutout_worker.py"]
