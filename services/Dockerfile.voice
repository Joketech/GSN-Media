FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg libsndfile1 sox libsox-fmt-all && rm -rf /var/lib/apt/lists/*
WORKDIR /worker
RUN pip install --no-cache-dir torch==2.8.0 torchaudio==2.8.0 --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir qwen-tts==0.1.1
COPY services/inference_worker.py /worker/inference_worker.py
ENV WORKER_KIND=voice DATA_DIR=/data HF_HOME=/models PYTHONUNBUFFERED=1
EXPOSE 8091
HEALTHCHECK --interval=30s --timeout=5s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8091/health',timeout=3)"
CMD ["python", "inference_worker.py"]
